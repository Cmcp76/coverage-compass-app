{
  "name": "georgia-weekend-finder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Free and paid events around Atlanta and nearby Georgia cities.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/build-site.mjs && node scripts/serve.mjs",
    "build": "node scripts/build-site.mjs",
    "update": "node scripts/update-events.mjs",
    "update:dry": "node scripts/update-events.mjs --dry-run",
    "update:offline": "node scripts/update-events.mjs --offline",
    "test": "node --test tests/*.mjs"
  }
}
