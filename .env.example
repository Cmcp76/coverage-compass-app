# Copy this file to .env.local (gitignored) for local development, or
# .env.production.local for a local production build. See worker/README.md
# for how to deploy the Worker this URL points at.

# Base URL of the deployed Coverage Compass analysis Worker (see /worker).
# Leave unset/commented to use the local pattern-matching fallback engine
# instead of real AI analysis - this is a fully supported, intentional
# state, not a broken one.
# VITE_ANALYSIS_API_URL=https://coverage-compass-analyze.<your-subdomain>.workers.dev
